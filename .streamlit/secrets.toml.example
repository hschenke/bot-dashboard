# ==============================================================================
# Streamlit Community Cloud Secrets Vorlage (`.streamlit/secrets.toml`)
# Unter App Settings -> Secrets in Streamlit Cloud einfügen
# ==============================================================================

# KI-Brain Speicher & optionale Vault-Passphrase
# Hinweis: Alle KI- & Tool-API-Keys (GEMINI_FREE_API_KEY, GEMINI_PAID_API_KEY,
# GROQ, OpenRouter, Tavily, Brave, Serper, Browserbase) werden verschlüsselt im
# KI-Brain Tab "Vault" (in Turso Cloud) verwaltet und müssen NICHT mehr hier
# hinterlegt werden!
BRAIN_TURSO_URL = ""
BRAIN_TURSO_KEY = ""
# Optional: eigener Vault-Verschlüsselungs-Key (bei Nutzung über mehrere Apps empfohlen;
# sonst wird automatisch BRAIN_TURSO_KEY bzw. TURSO_KEY genutzt)
# BRAIN_SECRET_KEY = ""

GITHUB_TOKEN = "github_pat_..."
APP_PASSWORD = ""
STREAMLIT_APP_URL = "https://holli-bot-dashboard.streamlit.app/"

# App 1: News-Bot
NEWS_BOT_URL = "https://holli-news-bot.streamlit.app/"
NEWS_BOT_REPO = "hschenke/news-bot"
NEWS_BOT_WORKFLOW = "daily_digest.yaml"
NEWS_BOT_TURSO_URL = "libsql://news-bot-hschenke.aws-eu-west-1.turso.io"
NEWS_BOT_TURSO_KEY = "ey..."

# App 2: Research-Bot
RESEARCH_BOT_URL = "https://holli-research-bot.streamlit.app/"
RESEARCH_BOT_REPO = "hschenke/research-bot"
RESEARCH_BOT_WORKFLOW = "run_research.yaml"
RESEARCH_BOT_TURSO_URL = "libsql://research-bot-hschenke.aws-eu-west-1.turso.io"
RESEARCH_BOT_TURSO_KEY = "ey..."

# App 3: Alert-Bot
ALERT_BOT_URL = "https://holli-alert-bot.streamlit.app/"
ALERT_BOT_REPO = "hschenke/alert-bot"
ALERT_BOT_WORKFLOW = "check_alerts.yaml"
ALERT_BOT_TURSO_URL = "libsql://alert-bot-hschenke.aws-eu-west-1.turso.io"
ALERT_BOT_TURSO_KEY = "ey..."

# Optional: Eigene Turso-DB für Dashboard-Historie & Brain
TURSO_URL = ""
TURSO_KEY = ""
