# ==============================================================================
# Bot-Dashboard – Lokale Umgebungsvariablen (Vorlage)
# Kopieren nach `.env` und echte Werte eintragen (NIEMALS `.env` committen!)
# ==============================================================================

# 1. Google Gemini API (für den KI-View: Systemdiagnose, Anomalie-Check & Q&A)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DEEP_MODEL=gemini-3.8-flash

# 2. GitHub Token (für Running-/Workflow-Checks & 1-Klick Action-Trigger aller 3 Bots)
# Fine-Grained PAT mit Read-Zugriff auf Actions (optional Write für Workflow-Dispatch)
GITHUB_TOKEN=

# 3. App 1: News-Bot (Streamlit URL, GitHub & Turso DB)
NEWS_BOT_URL=https://holli-news-bot.streamlit.app/
NEWS_BOT_REPO=hschenke/news-bot
NEWS_BOT_WORKFLOW=daily_digest.yaml
NEWS_BOT_TURSO_URL=libsql://news-bot-hschenke.aws-eu-west-1.turso.io
NEWS_BOT_TURSO_KEY=
NEWS_BOT_SQLITE_PATH=../news-aggregator-bot/data/news_bot.db

# 4. App 2: Research-Bot (Streamlit URL, GitHub & Turso DB)
RESEARCH_BOT_URL=https://holli-research-bot.streamlit.app/
RESEARCH_BOT_REPO=hschenke/research-bot
RESEARCH_BOT_WORKFLOW=run_research.yaml
RESEARCH_BOT_TURSO_URL=libsql://research-bot-hschenke.aws-eu-west-1.turso.io
RESEARCH_BOT_TURSO_KEY=
RESEARCH_BOT_SQLITE_PATH=../research-bot/data/research_bot.db

# 5. App 3: Alert-Bot (Streamlit URL, GitHub & Turso DB)
ALERT_BOT_URL=https://holli-alert-bot.streamlit.app/
ALERT_BOT_REPO=hschenke/alert-bot
ALERT_BOT_WORKFLOW=check_alerts.yaml
ALERT_BOT_TURSO_URL=libsql://alert-bot-hschenke.aws-eu-west-1.turso.io
ALERT_BOT_TURSO_KEY=
ALERT_BOT_SQLITE_PATH=../alert-bot/data/alert_bot.db

# 6. Eigene Persistenz des Dashboards (Check-Historie & Snapshots)
# Leer lassen = lokales SQLite unter `data/bot_dashboard.db`
TURSO_URL=
TURSO_KEY=

# 7. Optionaler Passwortschutz für das Dashboard
APP_PASSWORD=
STREAMLIT_APP_URL=https://holli-bot-dashboard.streamlit.app/
